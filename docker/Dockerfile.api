# API image for the canonical layout (contracts/, ml/, api/, config/). Fixture mode by
# default. Data and checkpoints are mounted at runtime, never baked in (KS-OPS-02 extends
# this with the web build and model mode).
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.13 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/app/.venv UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock README.md ./
COPY contracts ./contracts
COPY ml ./ml
COPY api ./api
COPY config ./config
RUN uv sync --frozen --no-dev
RUN useradd --create-home app
USER app
ENV PATH="/app/.venv/bin:$PATH" KNEESCOPE_MODE=fixture
EXPOSE 8000
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/readyz')"
CMD ["uvicorn", "kneescope_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
