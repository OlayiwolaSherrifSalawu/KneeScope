# Copy to .env (git-ignored) or export in your shell. Names only — never put secrets here.

# API run mode: "fixture" (synthetic studies, fixture results) or "model" (not implemented yet).
KNEESCOPE_MODE=fixture
# Finding profile from contracts/findings.json: interaction_prototype | rsna4 | mrnet3
KNEESCOPE_FINDING_PROFILE=interaction_prototype
# Comma-separated origins allowed by CORS (the Vite dev server by default).
KNEESCOPE_CORS_ORIGINS=http://localhost:5173
KNEESCOPE_LOG_LEVEL=info

# Model mode (KS-API-01/02) — local paths outside git:
# KNEESCOPE_MANIFEST=artifacts/manifest/studies.json
# KNEESCOPE_DATA_ROOT=data/rsna
# Checkpoint path/hash live in config/model.toml.

# Web (Vite). Defaults to /api, proxied to http://localhost:8000 in dev.
# VITE_API_BASE_URL=/api

# Kaggle / dataset credentials are NOT configured here. Use each tool's own credential
# store (e.g. ~/.kaggle/kaggle.json with chmod 600) and accept dataset terms yourself.

# Former src/knee_api variables map to: LOG_LEVEL -> KNEESCOPE_LOG_LEVEL,
# CORS_ORIGINS -> KNEESCOPE_CORS_ORIGINS (comma-separated), MODEL_PATH -> config/model.toml
# checkpoint_path. APP_ENV is replaced by KNEESCOPE_MODE.
